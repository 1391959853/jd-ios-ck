# 青龙面板配置
QL_BASE_URL=http://192.168.31.232:5700

# 青龙客户端 ID 和密钥（需要从青龙面板获取）
# 青龙面板 -> 系统设置 -> 登录设置 -> 新建应用
QL_CLIENT_ID=your_client_id
QL_CLIENT_SECRET=your_client_secret

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=9090
DEBUG_MODE=False

# 日志级别
LOG_LEVEL=INFO

# wskey 转换代理列表（可选，socks5 代理）
# PROXY_LIST=socks5://192.168.2.17:10001,socks5://192.168.2.17:10002
